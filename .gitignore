# Downloads grandes e dados brutos: ficam so no computador de quem roda o pipeline
dados/bruto/*
!dados/bruto/.gitkeep
docs/cnes/
# Microdados nacionais do INEP (centenas de MB): versione so o recorte microdados_ed_basica_rio_claro.csv
docs/educacao/microdados_ed_basica_20[0-9][0-9].csv
dados/bruto/escolas/microdados_ed_basica_20[0-9][0-9].csv
docs/ibge/
*.zip
*.parte
*.shp
*.dbf
*.shx
*.parquet

# Python / testes
__pycache__/
.pytest_cache/
*.pyc
.venv/

# Segredos locais: nunca versionar
.env
.env.*

# Bancos de dados e cópias de segurança: podem conter dados pessoais; nunca versionar
*.db
*.sqlite
*.sqlite3
*.backup
*.bak

# Sugestões do geocodificador (planilha de trabalho local; o que vale entra no catálogo depois de revisado)
dados/geocodificacao_*.csv

# Tabelas do Censo Escolar (INEP): cada linha é uma escola do Brasil inteiro (só contagens), e por isso o arquivo
# passa de 100 MB (o GitHub recusa mais que isso). Ficam só no computador de quem usa. Para Rio Claro, o pipeline
# gera um arquivo pequeno e público: python pipeline/oferta_educacao_infantil.py -> web/dados/oferta_educacao_infantil.json
docs/educacao/dados/
# GeoPackage estadual do IBGE é enorme: nunca vai para o Git
*.gpkg
