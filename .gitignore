docs/ibge/
*.zip
*.parte
*.shp
*.dbf
*.shx
*.parquet

# Python / testes
__pycache__/
.pytest_cache/
*.pyc
.venv/

# Provedor de pesquisa real (credenciais so por variavel de ambiente, mas nao arrisque)
pipeline/provedor_pesquisa.py

# Chaves de API: NUNCA no git
.env
.env.*
!.env.exemplo

